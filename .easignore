# EAS Build no combina esto con .gitignore: si este archivo existe, EAS
# usa SOLO estas reglas para decidir qué subir. Lo que no esté aquí se sube.

# Dependencias y compilaciones locales (EAS las reinstala/regenera)
node_modules/
ios/
android/
.expo/
dist/
build/
*.tsbuildinfo

# Firmas y certificados nativos locales: EAS maneja sus propias credenciales
# (eas credentials), no hace falta ni conviene subir esto al build.
*.jks
*.p8
*.p12
*.key
*.keystore
*.cer
*.certSigningRequest
*.mobileprovision
*.pem

# Binarios y archivos pesados que no aportan nada al build
*.dmg
*.aab
*.apk
*.ipa
*.xcarchive
*.zip

# icons/ guarda exports de diseño pesados; solo suben los dos íconos
# que usa app.config.ts para iOS (icon-dev.png / icon-prod.png)
/icons/*
!/icons/icon-dev.png
!/icons/icon-prod.png

# assets/icons sí se sube completo (íconos usados en la app)
!/assets/icons/

# macOS / editor
.DS_Store
.vscode/

# Tests y config que el build no necesita
test/
.gitignore
Makefile

# Variables de entorno locales (no las credenciales de Firebase:
# esas SÍ deben subir porque app.config.ts las necesita para el build)
.env
.env.*
!.env.example
