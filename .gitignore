# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# Dependencias
node_modules/

# Expo
.expo/
dist/
web-build/
.eas/

# Nativo (generado por `expo prebuild`, no se versiona)
ios/
android/

# Firmas y certificados nativos
*.jks
*.p8
*.p12
*.key
*.keystore
*.cer
*.certSigningRequest
*.mobileprovision
*.pem

# Metro
.metro-health-check*

# Debug / logs
npm-debug.*
yarn-debug.*
yarn-error.*
*.log
*.orig.*

# TypeScript
*.tsbuildinfo

# Binarios y archivos pesados
*.dmg
*.aab
*.apk
*.ipa
*.xcarchive
*.zip

# Variables de entorno (todas las variantes salvo el ejemplo)
.env
.env.*
!.env.example

# Firebase / credenciales de servicio
firebase-adminsdk*.json
serviceAccountKey.json
google-services.json
GoogleService-Info.plist

# icons/ guarda exports de diseño pesados (zips, capturas, .icon bundles);
# solo los dos íconos que usa app.config.ts van al repo
/icons/*
!/icons/icon-dev.png
!/icons/icon-prod.png

# macOS / editor
.DS_Store
.vscode/*
!.vscode/extensions.json
